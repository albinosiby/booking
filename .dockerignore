# Start with no files; include only frontend build sources and deployment code.
**
!Dockerfile
!.dockerignore
!railway.json
!pubspec.yaml
!pubspec.lock
!analysis_options.yaml
!lib/
!lib/**
!web/
!web/**
!assets/
!assets/**
!landing-page/
!landing-page/**
!booking-website/
!booking-website/**
!admin-panel/
!admin-panel/**
