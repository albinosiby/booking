# Shared public project settings. These are also Flutter Docker build arguments.
SUPABASE_URL=https://scwwkaywewecspsrskft.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_d6iVFApYyh41BlF9GkTsgw_h0d-chZN
BOOKING_API_BASE_URL=https://scwwkaywewecspsrskft.supabase.co/functions/v1/booking-api
BOOKING_API_PUBLISHABLE_KEY=sb_publishable_d6iVFApYyh41BlF9GkTsgw_h0d-chZN

# Password-only panel login. Set this as a runtime variable in Railway.
ADMIN_PANEL_PASSWORD="tatos tech"
# Set the same random signing secret here and in the booking-api backend secrets.
ADMIN_SESSION_SECRET=

# Relative links work immediately on Railway's generated domain.
BOOKING_APP_URL=/app
# Customer subdomains use booking homepages; the Railway host keeps /<slug> URLs.
BOOKING_ROUTING_MODE=auto
BOOKING_SITE_DOMAIN=bookingos.online
# Let Railway supply PORT. For local Docker runs it defaults to 8080.
# Supabase Edge region; keep equal to the database region (booking project: ap-northeast-1).
BOOKING_API_REGION=ap-northeast-1
