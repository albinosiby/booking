NODE_ENV=development
PORT=3000
FIREBASE_PROJECT_ID=demo-eden-booking
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
PGLITE_PATH=../.local/postgres
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
PUBLIC_APP_URL=http://localhost:8080
# Production: unset FIREBASE_AUTH_EMULATOR_HOST, use a real Firebase project,
# workload credentials, NODE_ENV=production and DATABASE_URL.
# DATABASE_URL=postgresql://...
# DATABASE_CA_FILE=/run/secrets/postgres-ca.pem

# Admin API: same random secret as the admin panel (at least 32 characters).
# No Supabase Auth admin email/password is required.
ADMIN_SESSION_SECRET=

# Exact hosted Flutter web origins, comma-separated during a domain transition.
# Merged with the existing BOOKING_CORS_ORIGINS list; no wildcards or URL paths.
# Production: configure this on the Supabase booking-api, not only in Railway.
BOOKING_WEB_ORIGIN=

# Team access email: server-only SMTP settings (provider credentials required).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
TEAM_LOGIN_WEB_URL=https://bookingos.online/app/sign-in

# Exact admin web callback used by platform Sarvam MCP authorization (HTTPS).
SARVAM_ADMIN_REDIRECT_URI=https://YOUR-ADMIN-DOMAIN/admin/agent-requests/mcp/callback
# Optional: Sarvam-approved OAuth client; otherwise register on first Connect.
# SARVAM_OAUTH_CLIENT_ID=
