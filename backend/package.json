{
  "name": "eden-booking-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "test": "tsx --test test/*.test.ts",
    "emulators": "firebase emulators:start --only auth --project demo-eden-booking --config ../firebase.json --import ../.local/auth --export-on-exit ../.local/auth",
    "format": "prettier --write src test edge scripts/build-edge.mjs tsconfig.edge.json",
    "format:check": "prettier --check src test edge scripts/build-edge.mjs tsconfig.edge.json",
    "edge:build": "node scripts/build-edge.mjs",
    "edge:check": "tsc -p tsconfig.edge.json"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "country-state-city": "^3.2.1",
    "exceljs": "^4.4.0",
    "firebase-admin": "^13.0.0",
    "helmet": "^8.0.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.15.0",
    "deno": "2.9.6",
    "esbuild": "0.25.12",
    "firebase-tools": "^15.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
